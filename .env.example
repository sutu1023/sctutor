# 复制为.env，在本地填写。不要提交密钥；完整说明见docs/handover/models.md。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_PROFILE=standard
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_REVISION=
# 本机HTTP/无密钥服务须显式允许；仅loopback有效。
LLM_ALLOW_LOCAL=false
EMBEDDING_ALLOW_LOCAL=false
# 可选搜索，默认关闭；启用可能收费。
TAVILY_API_KEY=
# 仅macOS PowerPoint可用；容器保持false。
ENABLE_ENHANCEMENT=false
COURSE_DIR=courses
DATA_DIR=data
PORT=8000
